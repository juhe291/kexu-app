<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+：精确闹钟需用户授权（设置页提供跳转），未授权时自动回退 WorkManager -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 仅「检查更新」访问 GitHub Releases 时需要网络；其余功能完全离线 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kexu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kexu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 精确闹钟到点：发通知 -->
        <receiver
            android:name=".notify.ExactAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 改时间 / 改时区 / 应用更新后重建精确闹钟（AlarmManager 闹钟不跨重启保留） -->
        <receiver
            android:name=".notify.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
